# Copy to .env and fill in
DATABASE_URL=sqlite:///./darukaa.db
# For production: postgresql+psycopg2://user:password@db:5432/darukaa
# SUPABASE example: postgresql+psycopg2://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
REDIS_URL=
QDRANT_URL=
QDRANT_API_KEY=
OPENAI_API_KEY=
EMBEDDING_PROVIDER=hash
VECTOR_BACKEND=local
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
